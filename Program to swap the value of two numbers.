#include <stdio.h>

int main() {
  int a,b,temp;
  printf("Original value of a is: ");
  scanf("%d", &a);
  
  printf("Original value of b is :");
  scanf("%d", &b);
  
  temp=a;
  a=b;
  b=temp;
  
  printf("Swap value of a is : %d\n", a);
  printf("Swap value of b is : %d\n", b);
  
    return 0;
}
